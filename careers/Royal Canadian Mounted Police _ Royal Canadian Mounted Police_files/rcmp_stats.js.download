/**
 * @file
 * RCMP Statistics functionality.
 */

(function ($, drupalSettings) {
  $(document).ready(function () {
    // Check if the current path is not an administrative path
    if (!drupalSettings.path.is_admin) {
      setTimeout(() => {
        $.ajax({
          type: "POST",
          cache: false,
          url: drupalSettings.rcmp_stats.url,
          data: drupalSettings.rcmp_stats.data,
        });
      });
    }
  });
})(jQuery, drupalSettings);
